  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "docker:up": "docker compose up -d",
    "docker:up:mysql": "docker compose -f docker-compose.mysql.yml up -d",
    "docker:up:postgres": "docker compose -f docker-compose.postgres.yml up -d",
    "docker:down": "docker compose down",
    "docker:down:mysql": "docker compose -f docker-compose.mysql.yml down",
    "docker:down:postgres": "docker compose -f docker-compose.postgres.yml down",
    "docker:logs": "docker compose logs -f",
