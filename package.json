    "db:push:docker": "drizzle-kit push",
    "db:migrate:docker": "drizzle-kit migrate",
    "db:seed:docker": "tsx scripts/seed-admins.ts",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:generate:postgres": "DB_TYPE=postgres dotenv -e .env.local -- drizzle-kit generate",
    "db:generate:mysql": "DB_TYPE=mysql dotenv -e .env.local -- drizzle-kit generate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
